    <assignments>
        <description>Selhání odeslání nesmí zastavit vydání voucheru (AC-2); voucher člen najde v portálu.</description>
        <name>Email_Failed</name>
        <label>E-mail se nepodařilo poslat</label>
        <locationX>440</locationX>
        <locationY>539</locationY>
        <assignmentItems>
            <assignToReference>EmailError</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Karta cerpani-email: po vydání voucheru pošle členovi (osobě, u firmy řidiči) e-mail s kódem. Bez e-mailu se nic neposílá a voucher se vydá i tak (AC-2.1).</description>
    <environments>Default</environments>
    <formulas>
        <description>Kontakt příjemce: firma přes řidiče, osoba přes PersonContactId.</description>
        <name>RecipientContactId</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!$Record.Loyalty_Member__r.Contact__c}, {!$Record.Loyalty_Member__r.Account__r.PersonContactId})</expression>
    </formulas>
    <interviewLabel>Kapka – e-mail s kódem voucheru {!$Flow.CurrentDateTime}</interviewLabel>
