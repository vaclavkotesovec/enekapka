<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Quantity_Must_Be_Positive</fullName>
    <active>true</active>
    <description>Položka nákupu má vždy kladné množství.</description>
    <errorConditionFormula><![CDATA[OR(ISBLANK(Quantity__c), Quantity__c <= 0)]]></errorConditionFormula>
    <errorDisplayField>Quantity__c</errorDisplayField>
    <errorMessage>Množství musí být větší než nula.</errorMessage>
</ValidationRule>
