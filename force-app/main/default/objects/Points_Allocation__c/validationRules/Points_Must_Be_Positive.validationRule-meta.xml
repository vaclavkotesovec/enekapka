<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Points_Must_Be_Positive</fullName>
    <active>true</active>
    <description>Znaménko nese pohyb, alokace vyjadřuje množství.</description>
    <errorConditionFormula><![CDATA[OR(ISBLANK(Points__c), Points__c <= 0)]]></errorConditionFormula>
    <errorDisplayField>Points__c</errorDisplayField>
    <errorMessage>Alokace musí mít kladný počet kapek.</errorMessage>
</ValidationRule>
