<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Valid_To_Not_Before_Valid_From</fullName>
    <active>true</active>
    <description>Období kampaně nesmí končit dřív, než začne.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Valid_To__c)), NOT(ISBLANK(Valid_From__c)), Valid_To__c &lt; Valid_From__c)</errorConditionFormula>
    <errorDisplayField>Valid_To__c</errorDisplayField>
    <errorMessage>Datum „Platí do“ nesmí být dřív než „Platí od“.</errorMessage>
</ValidationRule>
