<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Reward_Value_Must_Be_Positive</fullName>
    <active>true</active>
    <description>AC-2.2: kampaň bez kladné odměny nedává smysl.</description>
    <errorConditionFormula>OR(ISBLANK(Reward_Value__c), Reward_Value__c &lt;= 0)</errorConditionFormula>
    <errorDisplayField>Reward_Value__c</errorDisplayField>
    <errorMessage>Hodnota odměny musí být větší než 0.</errorMessage>
</ValidationRule>
