<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Fixed_Reward_Must_Be_Whole</fullName>
    <active>true</active>
    <description>R8 (review T1): kniha kapek drží jen celé kapky, pevná odměna musí být celé číslo.</description>
    <errorConditionFormula>AND(ISPICKVAL(Reward_Type__c, &quot;Fixed Points&quot;), NOT(ISBLANK(Reward_Value__c)), Reward_Value__c &lt;&gt; FLOOR(Reward_Value__c))</errorConditionFormula>
    <errorDisplayField>Reward_Value__c</errorDisplayField>
    <errorMessage>Pevná odměna musí být celý počet kapek.</errorMessage>
</ValidationRule>
