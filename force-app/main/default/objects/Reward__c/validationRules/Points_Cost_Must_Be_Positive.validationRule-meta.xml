<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Points_Cost_Must_Be_Positive</fullName>
    <active>true</active>
    <description>AC-4.2: odměna zdarma by šla čerpat bez kapek.</description>
    <errorConditionFormula>OR(ISBLANK(Points_Cost__c), Points_Cost__c &lt;= 0)</errorConditionFormula>
    <errorDisplayField>Points_Cost__c</errorDisplayField>
    <errorMessage>Cena odměny musí být větší než 0 kapek.</errorMessage>
</ValidationRule>
