<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Adjustment_Requires_Reason</fullName>
    <active>true</active>
    <description>Ruční úprava musí mít zdůvodnění.</description>
    <errorConditionFormula><![CDATA[AND(ISPICKVAL(Type__c, "Adjustment"), ISBLANK(Reason__c))]]></errorConditionFormula>
    <errorDisplayField>Reason__c</errorDisplayField>
    <errorMessage>U úpravy vyplňte důvod.</errorMessage>
</ValidationRule>
