<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Manual_Requires_Reason</fullName>
    <active>true</active>
    <description>Každý ruční pohyb kapek (připsání i úprava) musí mít důvod (karta bonus: ruční úprava kapek, AC-2, review SP-1).</description>
    <errorConditionFormula><![CDATA[AND(ISPICKVAL(Source__c, "Manual"), ISBLANK(Reason__c))]]></errorConditionFormula>
    <errorDisplayField>Reason__c</errorDisplayField>
    <errorMessage>U ruční úpravy vyplňte důvod.</errorMessage>
</ValidationRule>
